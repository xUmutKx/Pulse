        <!-- restarts the monitor and downloads every 15 minutes while the watchdog is on (see Watchdog.kt) -->
        <receiver android:name=".WatchdogReceiver" android:exported="false" />
        <service android:name="com.umutk.pulse.features.DownloadService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="downloads that carry on in the background" />
        </service>
        <service android:name="com.umutk.pulse.features.InstallService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="installs that carry on in the background" />
        </service>
        <service android:name=".MonitorService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="live system monitor (floating numbers, notification, alerts)" />
        </service>
