<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 11 dark Acrylic: a translucent dark grey panel with a faint sheen and a thin light edge, the wallpaper stays visible behind it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D1202020" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#22FFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
