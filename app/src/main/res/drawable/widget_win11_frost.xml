<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 11 light frosted blue: a translucent pale blue panel with a soft white edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#B8DDF6FF"
        android:centerColor="#A6C9EEFB"
        android:endColor="#B4A9D6F3"
        android:type="linear" />
