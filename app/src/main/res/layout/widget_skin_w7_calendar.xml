<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 7 calendar page: month and year, the big day (id day, red on Sundays), the weekday; live TextClocks over the skin's background bitmap (Skins.drawBackground). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="27" />

        <TextClock
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:format12Hour="MMMM yyyy"
            android:format24Hour="MMMM yyyy"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#404040" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="6" />

        <TextClock
            android:id="@+id/day"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="60"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#343434" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="6" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#606060" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="11" />
    </LinearLayout>

</FrameLayout>
