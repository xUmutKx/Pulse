<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/is_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <FrameLayout android:id="@+id/is_c_prev" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/is_prev" android:layout_width="match_parent" android:layout_height="match_parent" /></FrameLayout>
    <FrameLayout android:id="@+id/is_c_play" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/is_play" android:layout_width="match_parent" android:layout_height="match_parent" /></FrameLayout>
    <FrameLayout android:id="@+id/is_c_next" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/is_next" android:layout_width="match_parent" android:layout_height="match_parent" /></FrameLayout>
    <FrameLayout android:id="@+id/is_c_stop" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/is_stop" android:layout_width="match_parent" android:layout_height="match_parent" /></FrameLayout>
</FrameLayout>
