<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
    <ImageView android:id="@+id/mw_art" android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/widget_music_art_bg" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/widget_music_play" android:padding="14dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" />
        <ProgressBar android:id="@+id/mw_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:max="1000" />
    </LinearLayout>
    <ImageView android:id="@+id/mw_prev" android:layout_width="36dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/widget_music_prev" android:contentDescription="@null" />
    <ImageView android:id="@+id/mw_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_music_btn" android:padding="10dp" android:src="@drawable/widget_music_play" />
    <ImageView android:id="@+id/mw_next" android:layout_width="36dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/widget_music_next" android:contentDescription="@null" />
</LinearLayout>
