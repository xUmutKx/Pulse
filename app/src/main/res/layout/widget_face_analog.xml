<?xml version="1.0" encoding="utf-8"?>
<!-- A live analog face: dial and hands are bitmaps set per look (FaceWidget), AnalogClock turns them by itself. No background, so the dial's own alpha shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <AnalogClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
