<?xml version="1.0" encoding="utf-8"?>
<!-- A live analog skin: dial and hands are set per skin with setIcon; the cap sits over the hands. centerInside scales like AnalogClock does (down only), so the cap stays on the dial. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <AnalogClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/cap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside" />

</FrameLayout>
