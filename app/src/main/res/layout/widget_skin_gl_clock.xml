<?xml version="1.0" encoding="utf-8"?>
<!-- Glass clock: the panel and white hands, with the big translucent hour and minute over them (white over white hands looks the same as under). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <AnalogClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/cap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="17" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="32"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH"
            android:format24Hour="HH"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#AAFFFFFF" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="8" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="32"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#AAFFFFFF" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="11" />
    </LinearLayout>

</FrameLayout>
