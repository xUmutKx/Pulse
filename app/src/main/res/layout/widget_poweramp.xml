<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/pa_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <LinearLayout android:id="@+id/pa_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <View android:id="@+id/pa_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:id="@+id/pa_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:id="@+id/pa_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
