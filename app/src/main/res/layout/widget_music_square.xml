<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg" android:orientation="vertical" android:padding="10dp">
    <ImageView android:id="@+id/mw_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/widget_music_art_bg" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/widget_music_play" android:padding="30dp" />
    <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" />
    <ProgressBar android:id="@+id/mw_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="1000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/mw_prev" android:layout_width="40dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/widget_music_prev" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_play" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@drawable/widget_music_btn" android:padding="9dp" android:src="@drawable/widget_music_play" />
        <ImageView android:id="@+id/mw_next" android:layout_width="40dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/widget_music_next" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
