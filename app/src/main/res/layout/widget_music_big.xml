<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/mw_art" android:layout_width="120dp" android:layout_height="120dp"
            android:background="@drawable/widget_music_art_bg" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/widget_music_play" android:padding="38dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="3" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/mw_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:max="1000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/mw_shuf" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/widget_music_shuffle" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_prev" android:layout_width="56dp" android:layout_height="48dp" android:padding="11dp" android:src="@drawable/widget_music_prev" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_music_btn" android:padding="13dp" android:src="@drawable/widget_music_play" />
        <ImageView android:id="@+id/mw_next" android:layout_width="56dp" android:layout_height="48dp" android:padding="11dp" android:src="@drawable/widget_music_next" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_rep" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/widget_music_repeat" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
