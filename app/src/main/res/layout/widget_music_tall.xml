<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/mw_art" android:layout_width="84dp" android:layout_height="84dp"
            android:background="@drawable/widget_music_art_bg" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/widget_music_play" android:padding="26dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/mw_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:max="1000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/mw_shuf" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/widget_music_shuffle" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_prev" android:layout_width="56dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/widget_music_prev" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_play" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="@drawable/widget_music_btn" android:padding="12dp" android:src="@drawable/widget_music_play" />
        <ImageView android:id="@+id/mw_next" android:layout_width="56dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/widget_music_next" android:contentDescription="@null" />
        <ImageView android:id="@+id/mw_rep" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/widget_music_repeat" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
