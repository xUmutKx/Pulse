<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 11 date: weekday and month over the big day; live TextClocks over the skin's background bitmap (Skins.drawBackground). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/w11_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" />

        <TextClock
            android:id="@+id/w11_text1"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="17"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:format12Hour="EEE MMM"
            android:format24Hour="EEE MMM"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#60B6F6" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextClock
            android:id="@+id/w11_text2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="54"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#60B6F6" />
        <TextClock
            android:id="@+id/w11_text3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="13"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:format12Hour="yyyy"
            android:format24Hour="yyyy"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#60B6F6" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" />
    </LinearLayout>

</FrameLayout>
