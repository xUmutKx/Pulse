<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="10dp">
    <TextView android:id="@+id/lw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="11sp" />
    <TextView android:id="@+id/lw_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="2" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
