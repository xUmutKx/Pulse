<?xml version="1.0" encoding="utf-8"?>
<!-- Material date: weekday, the big day, month; live TextClocks over the skin's background bitmap (Skins.drawBackground). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="10" />

        <TextClock
            android:id="@+id/skin_t1"
            android:textAllCaps="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@android:color/system_neutral2_300" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" />

        <TextClock
            android:id="@+id/skin_t2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="44"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@android:color/system_accent1_200" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" />

        <TextClock
            android:id="@+id/skin_t3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:autoSizeMaxTextSize="400sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="MMM"
            android:format24Hour="MMM"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@android:color/system_accent1_100" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="16" />
    </LinearLayout>

</FrameLayout>
