<?xml version="1.0" encoding="utf-8"?>
<!-- the cassette, turntable and iPod looks' media notification: a picture of the player with the song on it, and three buttons drawn in the same look -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/ns_art"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitStart" />

    <ImageButton
        android:id="@+id/ns_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/ns_play"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/ns_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:scaleType="fitCenter" />
</LinearLayout>
