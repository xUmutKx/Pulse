<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- the whole shared storage: downloads can go to any folder the user picks -->
    <external-path name="shared" path="." />
    <!-- installer copies of picked APKs (see features/Installer.kt) -->
    <cache-path name="installer" path="installer/" />
    <!-- one entry taken out of an archive (Files > zip > APK > Install) and anything else Pulse puts in its cache -->
    <cache-path name="arc" path="arc/" />
    <cache-path name="cache" path="." />
    <external-cache-path name="ext_cache" path="." />
    <!-- Contacts call backgrounds (shared via ACTION_SEND) -->
    <files-path name="callbg" path="callbg/" />
    <!-- ArtCraft APKs downloaded to the app's own storage (install through the system installer) -->
    <files-path name="artcraft" path="artcraft/" />
    <!-- pictures kept by the keyboard clipboard (pasted into fields that take images) -->
    <files-path name="clips" path="clips/" />
</paths>
