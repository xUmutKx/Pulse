<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system's start window shows YTXTube's red play button on black, so there is one opening, drawn as YTXTube -->
    <style name="Theme.Ytx" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ytx_splash_icon</item>
    </style>
</resources>
